# Renombrar este archivo a .env y completar los valores

# ── Modelos ────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=...

# Modelo Gemini (orquestador y subagentes)
GEMINI_MODEL=gemini-2.5-flash

# Orquestador principal (por defecto usa GEMINI_MODEL)
ORCHESTRATOR_MODEL=gemini-2.5-flash

# Juez
JUDGE_MODEL=gemini-2.5-flash

# Embeddings
EMBEDDING_MODEL=gemini-embedding-001

# ── APIs reales ────────────────────────────────────────────────────────────────
# Open-Meteo (clima) y Overpass/OSM (atracciones). true = usar APIs reales.
USE_REAL_WEATHER=true
USE_REAL_ATTRACTIONS=true
# Travelpayouts / Aviasales — vuelos. Hoteles siguen mock (API Hotellook 404).
USE_REAL_FLIGHTS=true
TRAVELPAYOUTS_TOKEN=

# ── RAG ────────────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=6
RAG_RELEVANCE_THRESHOLD=0.5

# ── Memoria ────────────────────────────────────────────────────────────────────
MEMORY_PERSIST_DIR=./data/memory
MEMORY_TTL_DAYS=180

# ── Guardarraíles ───────────────────────────────────────────────────────────────
JUDGE_MIN_SCORE=0.7
MAX_JUDGE_RETRIES=2
RAIN_ALERT_MM=20.0

# ── MCP ────────────────────────────────────────────────────────────────────────
MCP_HOST=http://localhost:8001

# ── Envío de email (Resend) ────────────────────────────────────────────────────
# 1) Crear cuenta en https://resend.com (plan gratis)
# 2) Verificar tu dominio en Domains (agregar registros DNS)
# 3) API Keys → crear una key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente verificado (debe usar tu dominio verificado en Resend)
RESEND_FROM=Agente Turismo <itinerario@primesource.live>

# ── Google Calendar (OAuth Desktop) ────────────────────────────────────────────
# 1) Google Cloud Console → habilitar Google Calendar API
# 2) OAuth consent screen → agregar tu usuario de prueba
# 3) Credenciales → OAuth client ID → Aplicación de escritorio → descargar JSON
# 4) Guardar como credentials/credentials.json
# 5) python scripts/google_oauth_setup.py  (abre el navegador una vez)
GOOGLE_OAUTH_CLIENT_SECRETS=./credentials/credentials.json
GOOGLE_OAUTH_TOKEN=./credentials/token.json
# Email destinatario por defecto del itinerario (si el usuario no indica otro)
USER_EMAIL=tu.email@gmail.com
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TZ=America/Argentina/Buenos_Aires
# Al apretar "Aprobar" en el chat: enviar email + crear eventos
AUTO_DELIVER_ON_APPROVE=true
